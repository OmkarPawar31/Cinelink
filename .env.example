JWT_SECRET=change-me-to-a-long-random-string
TMDB_API_KEY=
TMDB_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Optional Google login (stub — set to enable button state)
GOOGLE_CLIENT_ID=
